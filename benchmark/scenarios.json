      "pipeline": {
        "format": "csv",
        "fields": {"id": "id", "name": "name"},
        "casts": {"id": "integer"}
      },
      "contract": {
        "required": ["id", "name"],
        "types": {"id": "integer", "name": "string"},
        "unique_key": "id",
        "min_rows": 3
      },
      "expected_status": "escalated",
      "expected_plan": {
        "operation": "escalate",
